# Site URL (used for OG images, sitemap, etc.)
# Replace with the custom domain after it is connected in Vercel.
NEXT_PUBLIC_SITE_URL=https://mystic-birth-chart.vercel.app

# Google Analytics / Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public support email shown in legal pages and mailto fallback.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@mysticbirthchart.com

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_BASIC_PRICE_ID=
STRIPE_COMPLETE_PRICE_ID=

# Birth details form URL (Formspree, Tally, Google Forms, etc.)
NEXT_PUBLIC_BIRTH_DETAILS_FORM_URL=
