# Site URL (used for OG images, sitemap, etc.)
# Public brand domain. Do not use the Vercel preview URL in public copy or social assets.
NEXT_PUBLIC_SITE_URL=https://mysticbirthchart.com

# Google Analytics / Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFICATION=

# Public support email shown in legal pages and mailto fallback.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@mysticbirthchart.com

# Optional public social profile URLs. Empty values are not rendered.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Optional public newsletter signup URL (Substack, Brevo landing page, etc.).
NEXT_PUBLIC_NEWSLETTER_SIGNUP_URL=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_COMPLETE_PRICE_ID=
STRIPE_LOVE_PRICE_ID=
STRIPE_CAREER_PRICE_ID=
STRIPE_YEAR_AHEAD_PRICE_ID=
STRIPE_SYNASTRY_PRICE_ID=
STRIPE_KABBALAH_PRICE_ID=
STRIPE_DOSSIER_PRICE_ID=
STRIPE_ALMANAC_PRICE_ID=

# SMTP (Hostinger email – used by /api/email to send order notifications)
SMTP_PASSWORD=

# Private Essential AI delivery worker. Never expose these as NEXT_PUBLIC variables.
ESSENTIAL_WORKER_URL=https://worker.mysticbirthchart.com
ESSENTIAL_WORKER_SHARED_SECRET=
ESSENTIAL_TEST_SECRET=

# Private AI proxy. The OpenAI key itself belongs only in Vercel as OPENAI_API_KEY.
AI_PROXY_URL=https://mysticbirthchart.com
OPENAI_API_KEY=
OPENAI_WRITER_MODEL=gpt-5.6-terra
OPENAI_REVIEWER_MODEL=gpt-5.6-terra

# Optional Brevo contact capture for the free PDF newsletter opt-in.
BREVO_API_KEY=
BREVO_LIST_ID=
