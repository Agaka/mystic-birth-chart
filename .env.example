# Site URL (used for OG images, sitemap, etc.)
# Replace with the custom domain after it is connected in Vercel.
NEXT_PUBLIC_SITE_URL=https://mystic-birth-chart.vercel.app

# Google Analytics / Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Stripe Payment Links (if using hosted payment links)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_BASIC_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_COMPLETE_PAYMENT_LINK=

# Birth details form URL (Formspree, Tally, Google Forms, etc.)
NEXT_PUBLIC_BIRTH_DETAILS_FORM_URL=

# Stripe Checkout (if using API-based checkout)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
