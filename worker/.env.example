# Do not commit a real .env file.
WORKER_DOMAIN=worker.mysticbirthchart.com
PUBLIC_WORKER_URL=https://worker.mysticbirthchart.com
PORT=3005
SQLITE_PATH=/data/essential.sqlite
REPORTS_DIR=/data/reports

# Shared only with Vercel. Generate a long random value.
ESSENTIAL_WORKER_SHARED_SECRET=

# AI calls run through the private Vercel route so the provider key stays in Vercel.
AI_PROXY_URL=https://mysticbirthchart.com

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_FROM=hello@mysticbirthchart.com
SMTP_PASSWORD=
